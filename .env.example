# Copy to .env and tune for your machine:  cp .env.example .env
# Check your RAM first:  free -g

# ---------- dataset ----------
TOTAL_CHUNKS=5
TARGET_GB_PER_CHUNK=5.6          # 5 x 5.6 = 28 GB raw in HDFS
SOURCE_CSV=data/source/credit_card_transactions-ibm_v2.csv

# ---------- HDFS ----------
HDFS_BASE=/fraudlens
NN_SERVICE=namenode

# ---------- YARN (must fit inside your physical RAM) ----------
YARN_NM_MEMORY_MB=10240          # memory YARN may hand out on this node
YARN_NM_VCORES=4
YARN_MAX_ALLOC_MB=8192           # ceiling for a single container

# ---------- Spark standalone worker ----------
SPARK_WORKER_MEMORY=8g
SPARK_WORKER_CORES=4
